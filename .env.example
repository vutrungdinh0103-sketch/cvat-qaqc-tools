# ---------------------------------------------------------------------------
# CVAT QA/QC tool - cấu hình kết nối CVAT server
#
# Cách dùng:
#   cp .env.example .env      # (Windows: Copy-Item .env.example .env)
#   rồi điền thông tin thật vào file .env (file .env đã được .gitignore)
#
# Lưu ý: KHÔNG commit file .env chứa mật khẩu thật lên git.
# ---------------------------------------------------------------------------

# Địa chỉ CVAT server (có hoặc không có scheme http:// đều được)
CVAT_HOST=http://localhost:8080

# --- Cách 1 (khuyến nghị cho CI/bot): Access Token của CVAT -------------------
# Tạo token trong CVAT: Account -> Security -> Access tokens.
# Nếu khai báo CVAT_TOKEN thì không cần CVAT_USER/CVAT_PASS.
#CVAT_TOKEN=

# --- Cách 2: tài khoản + mật khẩu --------------------------------------------
# Tài khoản đăng nhập CVAT
CVAT_USER=admin

# Mật khẩu đăng nhập CVAT
CVAT_PASS=admin

# --- Cấu hình QA/QC (tuỳ chọn) ----------------------------------------------
# File cấu hình rule mặc định cho CLI mới (python -m qaqc)
QAQC_RULES=rules/driving_v1.yaml

# Mức độ lỗi tối thiểu khi tạo issue trên CVAT (error|warning|info)
QAQC_PUBLISH_SEVERITY=error

# Giới hạn số issue tạo mới cho mỗi job trong một lần chạy
QAQC_MAX_ISSUES_PER_JOB=50

